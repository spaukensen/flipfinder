      "parameters": {
        "jsCode": "// Extraire la réponse JSON de Groq\nconst response = $input.item.json;\nconst messageContent = response.choices[0].message.content;\n\n// Parser le JSON de la réponse\nlet analysisResult;\ntry {\n  // Extraire uniquement le JSON si la réponse contient du texte avant/après\n  const jsonMatch = messageContent.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    analysisResult = JSON.parse(jsonMatch[0]);\n  } else {\n    analysisResult = JSON.parse(messageContent);\n  }\n} catch (error) {\n  analysisResult = {\n    error: 'Impossible de parser la réponse',\n    raw_response: messageContent\n  };\n}\n\n// Ajouter des métadonnées\nconst result = {\n  ...analysisResult,\n  tokens_used: response.usage.total_tokens,\n  model_used: response.model,\n  timestamp: new Date().toISOString(),\n  status: analysisResult.score >= 0.7 ? '✅ OPPORTUNITÉ' : '❌ PASSER'\n};\n\nreturn result;"
      },
