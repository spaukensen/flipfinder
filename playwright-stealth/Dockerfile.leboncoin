FROM mcr.microsoft.com/playwright:v1.48.2-jammy

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install --production

# Copy the advanced server file
COPY server-advanced.js ./

# Expose port 3002 (different from interencheres on 3001)
EXPOSE 3002

# Run the advanced server
CMD ["node", "server-advanced.js"]
